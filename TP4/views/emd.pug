extends layout

block content
  .w3-container.w3-margin-top
    .w3-card-4.w3-padding
      header.w3-container.w3-teal
        h2 EMD Record Details

      .w3-container.w3-padding
        p
          b Nome:
          |  #{emd.nome.primeiro} #{emd.nome['último']}
        p
          b Data EMD:
          |  #{emd.dataEMD}
        p
          b Idade:
          |  #{emd.idade}
        p
          b Género:
          |  #{emd.género}
        p
          b Morada:
          |  #{emd.morada}
        p
          b Modalidade:
          |  #{emd.modalidade}
        p
          b Clube:
          |  #{emd.clube}
        p
          b Email:
          |  #{emd.email}
        p
          b Federado:
          |  #{emd.federado ? 'Sim' : 'Não'}
        p
          b Resultado:
          |  #{emd.resultado ? 'Admitido' : 'Não Admitido'}

      footer.w3-container.w3-light-grey
        p ID: #{emd.id}
        a.w3-btn.w3-round.w3-blue-grey.w3-margin-right(href="/emd") Voltar
        a.w3-btn.w3-round.w3-green(href=`/emd/edit/${emd.id}`) Editar