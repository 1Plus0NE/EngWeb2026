extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 EMD Records List 
        a.w3-btn.w3-round.w3-grey(href="/emd/register") +
    
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th Data
          th Modalidade
          th Resultado
          a.w3-btn.w3-round.w3-blue-grey.w3-small.w3-margin-right(href="/emd/sortDataDesc") Sort Date Desc 
          a.w3-btn.w3-round.w3-blue-grey.w3-small(href="/emd/sortNameAsc") Sort Name Asc
        each emd in list
          tr(onclick=`window.location='/emd/${emd.id}'` style="cursor:pointer")
            td= emd.nome
            td= emd.dataEMD
            td= emd.modalidade
            td= emd.resultado ? 'Admitido' : 'Não Admitido'
            td 
              a.w3-btn.w3-round.w3-blue-grey.w3-small(href=`/emd/edit/${emd.id}`) Edit
              a.w3-btn.w3-round.w3-red.w3-small.w3-margin-left(href=`/emd/delete/${emd.id}`) Delete
              