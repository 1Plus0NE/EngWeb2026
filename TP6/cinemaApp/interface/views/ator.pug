extends layout.pug

block content
  .w3-container.w3-margin-top
    .w3-card-4.w3-padding
      header.w3-container.w3-teal
        h2 #{ator.name}

      .w3-container.w3-padding
        table.w3-table-all.w3-margin-top
            tr
              th Estreias Filmes

            each filme in ator.films
              tr.w3-hover-dark-grey(onclick=`window.location='/filmes/${filme._id}'` style="cursor:pointer")
                td= filme.title
                
        footer.w3-container.w3-light-grey
            a.w3-btn.w3-round.w3-blue-grey.w3-margin-right(href="/atores") Voltar