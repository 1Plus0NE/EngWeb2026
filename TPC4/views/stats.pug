extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 EMD Records Stats

    .w3-container.w3-padding
      h3.w3-bold Sexo
      table.w3-table-all.w3-margin-bottom
        tr
          th Feminino
          th Masculino
        tr
          td= stats.sexo.F
          td= stats.sexo.M
          
      h3.w3-bold Modalidade
      table.w3-table-all.w3-margin-bottom
        tr
          th Modalidade
          th Contagem
        each val, key in stats.modalidade
          tr
            td= key
            td= val

      h3.w3-bold Clube
      table.w3-table-all.w3-margin-bottom
        tr
          th Clube
          th Contagem
        each val, key in stats.clube
          tr
            td= key
            td= val

      h3.w3-bold Resultado
      table.w3-table-all.w3-margin-bottom
        tr
          th Admitido
          th Não Admitido
        tr
          td= stats.resultado.yes
          td= stats.resultado.no

      h3.w3-bold Federado
      table.w3-table-all.w3-margin-bottom
        tr
          th Sim
          th Não
        tr
          td= stats.federado.yes
          td= stats.federado.no

      a.w3-btn.w3-round.w3-blue-grey.w3-margin-top(href="/emd") Voltar
