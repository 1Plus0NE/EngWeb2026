extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1.w3-left Lista de Filmes
      a.w3-btn.w3-round.w3-white.w3-right.w3-margin-top(href="/") Voltar
      .w3-clear
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          th Título
          th Ano
          th No. Géneros 
          th No. Atores
        each f in list
          tr.w3-hover-dark-grey(onclick=`window.location='/filmes/${f.id}'` style="cursor:pointer")
            td= f.id
            td= f.title
            td= f.year
            td= f.genres.length
            td= f.cast.length
      footer.w3-container.w3-light-grey
        a.w3-btn.w3-round.w3-blue-grey.w3-margin-right(href="/") Voltar    