extends layout

block content
  .w3-container.w3-margin-top
    .w3-card-4.w3-padding
      header.w3-container.w3-teal
        h2 #{f.title}

      .w3-container.w3-padding
        table.w3-table-all.w3-margin-top
            tr
                th Título
                td= f.title
            tr
                th Ano
                td= f.year
            tr
                th Géneros
                td= f.genres.join(', ')
            tr
                th Elenco 
                td= f.cast.join(', ')

        footer.w3-container.w3-light-grey
            a.w3-btn.w3-round.w3-blue-grey.w3-margin-right(href="/filmes") Voltar